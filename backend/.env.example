# Anthropic Claude API
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS_BLOG=3000
BLOG_TARGET_WORDS=800

# Shared secret so only your Apps Script project can POST ideas here
NODE_APP_SECRET=replace-with-a-long-random-string

# The Apps Script Web App deployment URL (fill in after Step: Apps Script doPost setup)
# Looks like: https://script.google.com/macros/s/AKfycb.../exec
APPS_SCRIPT_WEBAPP_URL=

# The shared secret Apps Script's doPost() will check for (can be same as NODE_APP_SECRET or different)
APPS_SCRIPT_SHARED_SECRET=replace-with-a-long-random-string

# Google Ads Keyword Planner (optional - keyword volume lookups degrade
# gracefully to null everywhere if any of these are unset)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

PORT=8080
